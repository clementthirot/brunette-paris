---
/** Appel à l'action final (11.8), réutilisé sur les pages d'offre (12.7). Fond sombre. */
import { getSettings } from '../../lib/content';
const { ctaFinal, coordonnees } = await getSettings();
---
<section class="cta bg-dark section">
  <div class="container container--narrow cta__inner" data-reveal-group="0.12">
    <h2 class="cta__title" data-reveal>{ctaFinal.title}</h2>
    <p class="cta__text" data-reveal>{ctaFinal.text}</p>
    <div class="cta__actions" data-reveal>
      <a href="/contact" class="btn">{ctaFinal.button}</a>
      <a href={coordonnees.email ? `mailto:${coordonnees.email}` : '/contact'} class="link-underline">{ctaFinal.secondary}</a>
    </div>
  </div>
</section>
<style>
  .cta__inner { text-align: center; display: grid; justify-items: center; gap: var(--space-5); }
  .cta__title { font-size: var(--text-3xl); max-width: 16ch; }
  .cta__text { color: var(--fg-on-dark-muted); font-size: var(--text-lg); }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-6); margin-top: var(--space-4); }
</style>
