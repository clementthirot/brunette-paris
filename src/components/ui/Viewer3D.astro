---
/** Visionneuse 3D unique et réutilisable (fichier .glb déclaré dans Keystatic, sinon forme provisoire). */
import { getSettings } from '../../lib/content';
interface Props { model?: string | null; shape?: string | null; autorotate?: boolean; class?: string; id?: string }
const { model, shape = 'cube', autorotate = true, class: cls = '', id } = Astro.props;
const { labels } = await getSettings();
---
<div class:list={['viewer', cls]} id={id} data-viewer data-model={model || undefined} data-shape={shape}
  data-autorotate={autorotate ? '' : undefined} role="img" aria-label={labels.viewer3d} data-cursor-hover>
  <svg class="viewer__hint" viewBox="0 0 40 16" aria-hidden="true"><path d="M2 8h36M2 8l5-5M2 8l5 5M38 8l-5-5M38 8l-5 5" fill="none" stroke="currentColor" stroke-width="1"/></svg>
</div>
<style>
  .viewer {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    touch-action: pan-y;
    cursor: grab;
  }
  .viewer:active { cursor: grabbing; }
  .viewer :global(.viewer__canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .viewer__hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    width: 2.5rem;
    transform: translateX(-50%);
    color: var(--sable-500);
    opacity: 0.7;
    pointer-events: none;
  }
</style>
<script>
  import { initViewers } from '../../scripts/viewer3d';
  initViewers();
</script>
