---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Fil d’Ariane" class="breadcrumb">
  <ol role="list">
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: var(--text-xs); letter-spacing: var(--tracking-ui); text-transform: uppercase; }
  .breadcrumb li + li::before { content: '/'; margin-right: var(--space-2); opacity: 0.5; }
  .breadcrumb a { opacity: 0.75; transition: opacity var(--dur-fast), color var(--dur-fast); }
  .breadcrumb a:hover { opacity: 1; color: var(--sable-500); }
</style>
