---
/**
 * Étapes reliées par une ligne de couture animée (pointillés sable tracés au scroll).
 * Même composant pour la frise de l'accueil (11.6) et les étapes des pages d'offre (12.4).
 *  - variant="frieze"   : frise horizontale sur desktop, une photo et deux lignes par étape ;
 *  - variant="vertical" : 4 étapes numérotées verticales.
 */
import Photo from './Photo.astro';
import type { Photo as PhotoT } from '../../lib/content';
interface Step { title: string; text?: string; photo?: PhotoT }
interface Props { steps: readonly Step[]; variant?: 'frieze' | 'vertical' }
const { steps, variant = 'vertical' } = Astro.props;
---
<ol role="list" class:list={['steps', `steps--${variant}`]} data-stitch={variant}>
  <span class="steps__stitch" aria-hidden="true"><span class="steps__stitch-line" data-stitch-line></span></span>
  {steps.map((s, i) => (
    <li class="step">
      {variant === 'frieze' && s.photo && <Photo photo={s.photo} ratio="4 / 5" class="step__photo" />}
      <span class="step__dot" aria-hidden="true"></span>
      <div class="step__body">
        <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="step__title">{s.title}</h3>
        {s.text && <p class="step__text">{s.text}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .steps {
    --dot: 11px;
    --line-x: calc(var(--dot) / 2);
    position: relative;
    display: grid;
    gap: var(--space-7);
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-left: var(--space-7);
  }
  .step__dot {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    border: 1px solid var(--accent-on-light);
    background: var(--bg-light);
    z-index: 1;
  }
  .steps--frieze .step__dot { top: auto; }
  .step__num {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-ui);
    color: var(--accent-on-light);
    margin-bottom: var(--space-2);
  }
  .step__title { font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .step__text { color: var(--fg-on-light-muted); max-width: 36ch; }

  /* Ligne de couture : verticale par défaut (mobile + variante verticale) */
  .steps__stitch {
    position: absolute;
    left: calc(var(--line-x) - 1px);
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
  }
  .steps__stitch-line {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, var(--sable-500) 0 7px, transparent 7px 13px);
  }
  :global(html.js) .steps__stitch-line { clip-path: inset(0 0 100% 0); }

  /* Frise horizontale sur desktop */
  @media (min-width: 56em) {
    .steps--frieze {
      grid-template-columns: repeat(var(--n, 4), 1fr);
      gap: var(--gutter);
      grid-auto-flow: column;
    }
    .steps--frieze .step {
      padding-left: 0;
      grid-template-rows: auto auto 1fr;
      gap: var(--space-5);
    }
    .steps--frieze .step__dot { position: relative; top: 0; }
    .steps--frieze .steps__stitch {
      left: 0;
      right: 0;
      bottom: auto;
      top: var(--stitch-top, 50%);
      width: auto;
      height: 2px;
    }
    .steps--frieze .steps__stitch-line {
      background: repeating-linear-gradient(90deg, var(--sable-500) 0 7px, transparent 7px 13px);
    }
    :global(html.js) .steps--frieze .steps__stitch-line { clip-path: inset(0 100% 0 0); }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';

  document.querySelectorAll<HTMLElement>('[data-stitch]').forEach((list) => {
    const line = list.querySelector<HTMLElement>('[data-stitch-line]')!;
    const stitch = line.parentElement!;
    const isFrieze = list.dataset.stitch === 'frieze';
    list.style.setProperty('--n', String(list.querySelectorAll('.step').length));

    // Place la ligne horizontale au niveau des points (sous les photos).
    const placeLine = () => {
      const dot = list.querySelector<HTMLElement>('.step__dot');
      if (isFrieze && dot) {
        const top = dot.getBoundingClientRect().top - list.getBoundingClientRect().top + dot.offsetHeight / 2 - 1;
        list.style.setProperty('--stitch-top', `${top}px`);
        // la ligne va du premier au dernier point
        const dots = list.querySelectorAll<HTMLElement>('.step__dot');
        const last = dots[dots.length - 1];
        const lr = list.getBoundingClientRect();
        stitch.style.right = window.matchMedia('(min-width: 56em)').matches
          ? `${lr.right - last.getBoundingClientRect().left - last.offsetWidth / 2}px` : '';
      }
    };
    placeLine();
    window.addEventListener('resize', placeLine);

    if (reducedMotion()) {
      gsap.set(line, { clipPath: 'inset(0 0 0 0)' });
      return;
    }
    const mm = gsap.matchMedia();
    const scrub = (from: string) =>
      gsap.fromTo(line, { clipPath: from }, {
        clipPath: 'inset(0% 0% 0% 0%)',
        ease: 'none',
        scrollTrigger: { trigger: list, start: 'top 75%', end: 'bottom 60%', scrub: 0.6 },
      });
    if (isFrieze) {
      mm.add('(min-width: 56em)', () => { scrub('inset(0% 100% 0% 0%)'); });
      mm.add('(max-width: 55.99em)', () => { scrub('inset(0% 0% 100% 0%)'); });
    } else {
      scrub('inset(0% 0% 100% 0%)');
    }
  });
</script>
