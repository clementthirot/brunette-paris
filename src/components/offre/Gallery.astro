---
/** Galerie en grille irrégulière (masonry). Clic = visionneuse plein écran. */
import Photo from '../ui/Photo.astro';
import type { Photo as PhotoT } from '../../lib/content';
import { getSettings } from '../../lib/content';
interface Props { photos: readonly PhotoT[]; title?: string }
const { photos, title } = Astro.props;
const { labels } = await getSettings();
// Ratios alternés pour créer le rythme irrégulier
const RATIOS = ['4 / 5', '1', '3 / 4', '4 / 3', '1', '4 / 5', '3 / 2', '3 / 4', '1'];
---
<div class="gallery" data-gallery>
  {title && <h2 class="section-title" data-reveal>{title}</h2>}
  <ul role="list" class="gallery__grid">
    {photos.map((p, i) => (
      <li class="gallery__item" data-reveal>
        <button class="gallery__btn" data-index={i} aria-label={p.alt || p.placeholder}>
          <Photo photo={p} ratio={RATIOS[i % RATIOS.length]} />
        </button>
      </li>
    ))}
  </ul>
  <dialog class="lightbox" data-lightbox aria-label={title}>
    <div class="lightbox__stage" data-lightbox-stage></div>
    <button class="lightbox__close" data-lightbox-close>{labels.close}</button>
    <button class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label={labels.previous}>←</button>
    <button class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label={labels.next}>→</button>
  </dialog>
</div>
<style>
  .gallery__grid { columns: 2; column-gap: var(--space-3); }
  .gallery__item { break-inside: avoid; margin-bottom: var(--space-3); }
  .gallery__btn { display: block; width: 100%; overflow: hidden; }
  .gallery__btn :global(.ph) { transition: transform 1.2s var(--ease-out); }
  .gallery__btn:hover :global(.ph) { transform: scale(1.04); }
  @media (min-width: 48em) {
    .gallery__grid { columns: 3; column-gap: var(--space-5); }
    .gallery__item { margin-bottom: var(--space-5); }
  }
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(12 10 8 / 0.96);
    color: var(--fg-on-dark);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox__stage {
    position: absolute;
    inset: 4rem var(--gutter);
    display: grid;
    place-items: center;
  }
  .lightbox__stage :global(.ph) { width: min(100%, 70vh); max-height: 100%; }
  .lightbox__stage :global(img) { object-fit: contain; }
  .lightbox__close {
    position: absolute;
    top: var(--space-4);
    right: var(--gutter);
    min-height: 44px;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
  }
  .lightbox__nav {
    position: absolute;
    top: 50%;
    width: 44px;
    height: 44px;
    transform: translateY(-50%);
    font-size: var(--text-xl);
    color: var(--sable-500);
  }
  .lightbox__nav--prev { left: var(--space-2); }
  .lightbox__nav--next { right: var(--space-2); }
</style>
<script>
  import { gsap, reducedMotion } from '../../scripts/motion';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const dialog = g.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lightbox-stage]')!;
    const items = Array.from(g.querySelectorAll<HTMLButtonElement>('.gallery__btn'));
    let index = 0;
    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const clone = items[index].querySelector('.ph')!.cloneNode(true) as HTMLElement;
      stage.replaceChildren(clone);
      if (!reducedMotion()) gsap.fromTo(clone, { opacity: 0 }, { opacity: 1, duration: 0.4 });
    };
    items.forEach((btn, i) => btn.addEventListener('click', () => { show(i); dialog.showModal(); }));
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  });
</script>
