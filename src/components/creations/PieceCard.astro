---
/** Carte pièce : photo 4:5, nom, cuir, mention unique / série limitée, disponibilité. 2e photo au survol. */
import Photo from '../ui/Photo.astro';
import { pieceUrl, type Piece } from '../../lib/content';
interface Props {
  piece: Piece;
  labels: { unique: string; limitee: string; disponible: string; vendue: string };
  cuirLabel: string;
}
const { piece, labels, cuirLabel } = Astro.props;
const [p1, p2] = piece.photos ?? [];
---
<article class="piece-card" data-category={piece.category} data-leather={piece.leather}>
  <a href={pieceUrl(piece.slug)} class="piece-card__link" data-cursor-label="Voir">
    <div class="piece-card__media">
      <Photo photo={p1} ratio="4 / 5" />
      {p2 && <Photo photo={p2} ratio="4 / 5" class="piece-card__alt" />}
    </div>
    <div class="piece-card__body">
      <h2 class="piece-card__name">{piece.title}</h2>
      <p class="piece-card__meta">
        <span>{cuirLabel}</span>
        <span>{piece.edition === 'unique' ? labels.unique : labels.limitee}</span>
        {piece.availability !== 'none' && (
          <span class:list={['piece-card__status', `is-${piece.availability}`]}>
            {piece.availability === 'disponible' ? labels.disponible : labels.vendue}
          </span>
        )}
      </p>
    </div>
  </a>
</article>
<style>
  .piece-card__link { display: grid; gap: var(--space-4); }
  .piece-card__media { position: relative; overflow: hidden; }
  .piece-card__media :global(.piece-card__alt) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }
  .piece-card__link:hover .piece-card__media :global(.piece-card__alt),
  .piece-card__link:focus-visible .piece-card__media :global(.piece-card__alt) { opacity: 1; }
  /* 2e photo provisoire : une autre peau (cuir naturel) pour rendre le survol lisible */
  .piece-card__media :global(.piece-card__alt) { --ph-leather-1: var(--sable-200); --ph-leather-2: var(--sable-500); --ph-ink: var(--sable-800); }
  .piece-card__name { font-size: var(--text-xl); }
  .piece-card__meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: var(--space-2); font-size: var(--text-xs); letter-spacing: var(--tracking-ui); text-transform: uppercase; color: var(--fg-on-light-muted); }
  .piece-card__status.is-disponible { color: var(--celadon-700); }
  .piece-card__status.is-vendue { color: var(--ink-500); text-decoration: line-through; text-decoration-thickness: 1px; }
</style>
