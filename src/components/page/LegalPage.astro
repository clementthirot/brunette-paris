---
/** Gabarit commun des pages légales : mentions légales, confidentialité, CGV. */
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/content';
interface Props {
  page: {
    seo: { title: string; description: string };
    h1: string;
    updated?: string | null;
    sections: readonly { title: string; text: string }[];
  };
}
const { page } = Astro.props;
---
<Base seo={page.seo} hero="light">
  <section class="legal bg-light">
    <div class="container container--narrow">
      <h1>{page.h1}</h1>
      {page.updated && <p class="legal__updated">Mise à jour le {formatDate(page.updated)}</p>}
      {page.sections.map((s) => (
        <section class="legal__section">
          <h2>{s.title}</h2>
          <p>{s.text}</p>
        </section>
      ))}
    </div>
  </section>
</Base>
<style>
  .legal { padding-block: calc(var(--header-h) + var(--space-8)) var(--section-y); }
  .legal h1 { font-size: var(--text-3xl); margin-bottom: var(--space-4); }
  .legal__updated { font-size: var(--text-sm); color: var(--fg-on-light-muted); margin-bottom: var(--space-7); }
  .legal__section { padding-block: var(--space-5); border-top: 1px solid var(--ink-200); }
  .legal__section h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .legal__section p { color: var(--fg-on-light-muted); white-space: pre-line; }
</style>
