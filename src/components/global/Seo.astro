---
/**
 * Balises de référencement du <head> : title, description, robots, canonique, Open Graph, Twitter,
 * vérifications Search Console / Bing et données structurées JSON-LD.
 */
import { SITE_NAME, DEFAULT_OG_IMAGE, isIndexable, absolute, absoluteFile } from '../../lib/seo';
import { imageSize, resolveAsset, shareImage } from '../../lib/images';

interface Props {
  title: string;
  description?: string;
  /** Chemin (public/) ou URL de l'image de partage. Sinon : image par défaut des réglages, puis /og-image.jpg. */
  image?: string | null;
  imageAlt?: string;
  /** Image de partage par défaut (Réglages globaux › Référencement). */
  defaultImage?: string | null;
  type?: 'website' | 'product' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  googleVerification?: string;
  bingVerification?: string;
}
const {
  title,
  description = '',
  image,
  imageAlt,
  defaultImage,
  type = 'website',
  noindex = false,
  jsonLd = [],
  googleVerification,
  bingVerification,
} = Astro.props;

const canonical = absolute(Astro.url.pathname, Astro.site);
const robots = noindex || !isIndexable ? 'noindex, follow' : 'index, follow, max-image-preview:large';

const ogSrc = image || defaultImage || DEFAULT_OG_IMAGE.src;
// Photo de src/assets : version JPG 1200 px générée par Astro (le chemin source n'est pas servi tel quel).
const ogShared = resolveAsset(ogSrc) ? await shareImage(ogSrc) : null;
const ogUrl = absoluteFile(ogShared?.src ?? ogSrc, Astro.site);
const ogSize = ogShared?.width
  ? { width: ogShared.width, height: ogShared.height! }
  : ogSrc === DEFAULT_OG_IMAGE.src ? DEFAULT_OG_IMAGE : await imageSize(ogSrc);
// La description de l'image ne suit que l'image de la page ; sinon, celle de l'image par défaut.
const ogAlt = (image && imageAlt) || (ogSrc === DEFAULT_OG_IMAGE.src ? DEFAULT_OG_IMAGE.alt : title);
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={robots} />
{!noindex && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
{ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
{ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={ogAlt} />

{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
<link rel="sitemap" href="/sitemap-index.xml" />

{jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
