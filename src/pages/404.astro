---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/content';
const { notFound } = await getSettings();
---
<Base title={notFound.seoTitle} hero="dark" noindex>
  <section class="nf bg-dark">
    <div class="container nf__inner">
      <p class="nf__code nums" aria-hidden="true">404</p>
      <h1 class="nf__phrase">{notFound.phrase}</h1>
      <a href="/" class="btn btn--ghost">{notFound.link}</a>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100vh; min-height: 100svh; display: grid; place-items: center; padding-block: var(--header-h); text-align: center; }
  .nf__inner { display: grid; justify-items: center; gap: var(--space-6); }
  .nf__code { font-family: var(--font-serif); font-size: clamp(5rem, 3rem + 10vw, 11rem); line-height: 1; color: var(--sable-500); }
  .nf__phrase { font-size: var(--text-3xl); max-width: 18ch; }
</style>
