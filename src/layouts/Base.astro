---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Cursor from '../components/global/Cursor.astro';
import Curtain from '../components/global/Curtain.astro';
import { getSettings, getOffres } from '../lib/content';
// Police du texte courant, préchargée pour un premier rendu sans saut de police (LCP, CLS).
import josefin400 from '@fontsource/josefin-sans/files/josefin-sans-latin-400-normal.woff2?url';

import Seo from '../components/global/Seo.astro';
import { SITE_NAME, DEFAULT_OG_IMAGE, absolute, absoluteFile, businessId, websiteId } from '../lib/seo';

/** Champs « Référencement » d'une page Keystatic (titre, description, image de partage, noindex). */
interface SeoFields {
  title: string;
  description?: string;
  ogImage?: string | null;
  ogImageAlt?: string;
  noindex?: boolean;
}
interface Props {
  /** Champs SEO Keystatic de la page ; title/description/image/noindex ci-dessous les complètent ou les remplacent. */
  seo?: SeoFields;
  title?: string;
  description?: string;
  /** Thème du haut de page : 'dark' = hero sombre (header transparent, texte clair). */
  hero?: 'dark' | 'light';
  jsonLd?: Record<string, unknown>[];
  /** Image de partage de repli (ex. photo du hero) si la page n'a pas d'image SEO dédiée. */
  image?: string | null;
  imageAlt?: string;
  type?: 'website' | 'product' | 'article';
  noindex?: boolean;
}
const { seo, hero = 'light', jsonLd = [], type = 'website' } = Astro.props;
const title = Astro.props.title ?? seo?.title ?? SITE_NAME;
const description = Astro.props.description ?? seo?.description ?? '';
const image = seo?.ogImage || Astro.props.image;
const imageAlt = (seo?.ogImage && seo?.ogImageAlt) || Astro.props.imageAlt;
const noindex = Astro.props.noindex || seo?.noindex || false;

const settings = await getSettings();
const offres = await getOffres();
const ref = settings.referencement;

// Entreprise (LocalBusiness) et site (WebSite) : déclarés en entier sur l'accueil et la page contact,
// les autres données structurées y renvoient par leur @id.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const withBusiness = path === '/' || path === '/contact';
const { coordonnees: c } = settings;
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': businessId(Astro.site),
  name: SITE_NAME,
  description: settings.footer.tagline || undefined,
  url: absolute('/', Astro.site),
  logo: absoluteFile('/logo-brunette-paris.png', Astro.site),
  image: absoluteFile(ref.ogImage || DEFAULT_OG_IMAGE.src, Astro.site),
  email: c.email || undefined,
  telephone: c.phone || undefined,
  priceRange: ref.priceRange || undefined,
  openingHours: ref.openingHours || undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: ref.streetAddress || undefined,
    postalCode: ref.postalCode || undefined,
    addressLocality: c.city || undefined,
    addressRegion: c.region || undefined,
    addressCountry: 'FR',
  },
  areaServed: [
    c.city && { '@type': 'City', name: c.city },
    c.region && { '@type': 'AdministrativeArea', name: c.region },
  ].filter(Boolean),
  knowsAbout: ['Maroquinerie artisanale', 'Sellerie', 'Cuir sur mesure', 'Cadeaux d’entreprise en cuir'],
  sameAs: [ref.googleBusinessUrl, settings.reseaux.instagramUrl, settings.reseaux.etsyUrl].filter(Boolean),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId(Astro.site),
  name: SITE_NAME,
  url: absolute('/', Astro.site),
  inLanguage: 'fr-FR',
  publisher: { '@id': businessId(Astro.site) },
};
const ld = [...(withBusiness ? [business, website] : []), ...jsonLd];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      defaultImage={ref.ogImage}
      type={type}
      noindex={noindex}
      jsonLd={ld}
      googleVerification={ref.googleVerification}
      bingVerification={ref.bingVerification}
    />
    <meta name="theme-color" content="#151311" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={josefin400} crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-hero={hero}>
    <a class="skip-link" href="#contenu">{settings.nav.skip}</a>
    <Header settings={settings} offres={offres} />
    <main id="contenu">
      <slot />
    </main>
    <Footer settings={settings} offres={offres} />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />
    <Curtain />
    <script>
      import { initReveals } from '../scripts/motion';
      // Les composants de page ajoutent leurs propres animations ; les révélations génériques sont lancées ici, une seule fois.
      initReveals();
    </script>
  </body>
</html>
